@page "/voclist"
@rendermode InteractiveServer
@inject VocService VocService

<PageTitle>Word List</PageTitle>

<h1>Word List</h1>

@if (items is null)
{
    <p>Loading...</p>
}
else if (!items.Any())
{
    <p>No entries found.</p>
}
else
{
    <input class="form-control mb-4"
           placeholder="Search..."
           style="max-width: 400px;"
           @bind="searchTerm"
           @bind:event="oninput" />

    <div class="mb-4">
        <div class="filter-label">Filter by date</div>
        <div class="date-filter">
            @foreach (var date in AllDates)
            {
                <label class="date-chip @(IsDateVisible(date) ? "active" : "")">
                    <input type="checkbox" class="form-check-input"
                           checked="@IsDateVisible(date)"
                           @onchange="() => ToggleDate(date)" />
                    @date.ToString("dd.MM.yyyy")
                </label>
            }
        </div>
    </div>

    <div class="mb-4">
        <label class="date-chip @(examOnly ? "active" : "")">
            <input type="checkbox" class="form-check-input"
                   checked="@examOnly"
                   @onchange="() => examOnly = !examOnly" />
            Only exam words
        </label>
    </div>

    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>Date</th>
            <th>English</th>
            <th>German</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in FilteredItems)
        {
            <tr>
                <td style="font-family: var(--font-mono); font-size: 0.8rem;">@item.Date.ToString("dd.MM.yyyy")</td>
                <td>@item.English</td>
                <td>@item.German</td>
            </tr>
        }
        </tbody>
    </table>

    <p class="text-muted">@FilteredItems.Count() of @items.Count() entries</p>
}

@code {
    private IEnumerable<Vocabulary>? items;
    private string searchTerm = string.Empty;
    private HashSet<DateOnly> hiddenDates = new();
    private bool examOnly;

    private IEnumerable<DateOnly> AllDates => items?
        .Select(v => v.Date)
        .Distinct()
        .OrderByDescending(d => d)
        ?? Enumerable.Empty<DateOnly>();

    private bool IsDateVisible(DateOnly date) => !hiddenDates.Contains(date);

    private void ToggleDate(DateOnly date)
    {
        if (!hiddenDates.Remove(date))
            hiddenDates.Add(date);
    }

    private IEnumerable<Vocabulary> FilteredItems => items?
        .Where(v => !hiddenDates.Contains(v.Date))
        .Where(v => !examOnly || v.Exam)
        .Where(v =>
            string.IsNullOrEmpty(searchTerm) ||
            v.English.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            v.German.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Vocabulary>();

    protected override async Task OnInitializedAsync()
    {
        items = await VocService.GetAllAsync();
    }
}
