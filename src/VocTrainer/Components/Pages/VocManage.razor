@page "/vocmanage"
@rendermode InteractiveServer
@inject VocService VocService
@inject PinAuthState AuthState
@inject PinAuthService PinAuth
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Manage</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <h1>Manage Vocabulary</h1>
    <div class="card" style="max-width: 400px;">
        <div class="card-body">
            <div class="filter-label mb-2">Enter PIN to continue</div>
            @if (lockoutRemaining > TimeSpan.Zero)
            {
                <div class="alert alert-danger">
                    Too many failed attempts. Try again in @((int)lockoutRemaining.TotalMinutes + 1) minutes.
                </div>
            }
            else
            {
                @if (pinError)
                {
                    <div class="alert alert-danger">Wrong PIN.</div>
                }
                <div class="d-flex gap-2">
                    <input type="password" class="form-control" placeholder="PIN"
                           @bind="pinInput" @bind:event="oninput"
                           @onkeydown="PinKeyDown" />
                    <button class="btn btn-primary" @onclick="SubmitPin"
                            disabled="@string.IsNullOrWhiteSpace(pinInput)">
                        Unlock
                    </button>
                </div>
            }
        </div>
    </div>
    return;
}

<h1>Manage Vocabulary</h1>

<div class="card mb-4" style="max-width: 520px;">
    <div class="card-body">
        <div class="filter-label mb-2">@(editingItem is not null ? "Edit Entry" : "New Entry")</div>
        <div class="d-flex gap-2 mb-2">
            <input class="form-control" placeholder="German"
                   @bind="formGerman" @bind:event="oninput" />
            <input class="form-control" placeholder="English"
                   @bind="formEnglish" @bind:event="oninput" />
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="Save"
                    disabled="@(string.IsNullOrWhiteSpace(formGerman) || string.IsNullOrWhiteSpace(formEnglish))">
                @(editingItem is not null ? "Save" : "Add")
            </button>
            @if (editingItem is not null)
            {
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </div>
</div>

@if (items is null)
{
    <p>Loading...</p>
}
else if (!items.Any())
{
    <p style="color: var(--text-muted);">No entries yet.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>Date</th>
            <th>German</th>
            <th>English</th>
            <th style="width: 140px;"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td style="font-family: var(--font-mono); font-size: 0.8rem;">@item.Date.ToString("dd.MM.yyyy")</td>
                <td>@item.German</td>
                <td>@item.English</td>
                <td>
                    <div class="d-flex gap-2">
                        <button class="btn-icon" title="Edit" @onclick="() => StartEdit(item)">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M12.146.854a.5.5 0 0 1 .708 0l2.292 2.292a.5.5 0 0 1 0 .708l-9.5 9.5a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l9.5-9.5zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5z"/>
                            </svg>
                        </button>
                        <button class="btn-icon btn-icon-danger" title="Delete" @onclick="() => Delete(item)">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H5.5l1-1h3l1 1H13.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <p class="text-muted">@items.Count() entries</p>
}

<style>
    .btn-secondary {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        border-radius: var(--radius-sm);
        font-family: var(--font-body);
        font-weight: 500;
        font-size: 0.875rem;
        padding: 0.6rem 1.25rem;
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-secondary:hover {
        background: var(--bg-hover);
        color: var(--text-primary);
        border-color: var(--text-muted);
    }

    .btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--bg-elevated);
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-icon:hover {
        background: var(--accent-muted);
        border-color: var(--accent);
        color: var(--accent);
    }

    .btn-icon-danger:hover {
        background: var(--danger-bg);
        border-color: var(--danger);
        color: var(--danger);
    }
</style>

@code {
    private IEnumerable<Vocabulary>? items;
    private Vocabulary? editingItem;
    private string formGerman = string.Empty;
    private string formEnglish = string.Empty;

    private string pinInput = string.Empty;
    private bool pinError;
    private TimeSpan lockoutRemaining;

    private string ClientIp =>
        HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "unknown";

    protected override async Task OnInitializedAsync()
    {
        lockoutRemaining = PinAuth.GetRemainingLockout(ClientIp);
        if (AuthState.IsAuthenticated)
            await LoadItems();
    }

    private async Task SubmitPin()
    {
        if (PinAuth.IsLockedOut(ClientIp))
        {
            lockoutRemaining = PinAuth.GetRemainingLockout(ClientIp);
            return;
        }

        if (PinAuth.Verify(pinInput, ClientIp))
        {
            AuthState.IsAuthenticated = true;
            pinError = false;
            pinInput = string.Empty;
            await LoadItems();
        }
        else
        {
            pinError = true;
            pinInput = string.Empty;
            lockoutRemaining = PinAuth.GetRemainingLockout(ClientIp);
        }
    }

    private async Task PinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(pinInput))
            await SubmitPin();
    }

    private async Task LoadItems()
    {
        items = await VocService.GetAllAsync();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(formGerman) || string.IsNullOrWhiteSpace(formEnglish))
            return;

        if (editingItem is not null)
        {
            editingItem.German = formGerman.Trim();
            editingItem.English = formEnglish.Trim();
            await VocService.UpdateAsync(editingItem);
            editingItem = null;
        }
        else
        {
            var vocab = new Vocabulary
            {
                Date = DateOnly.FromDateTime(DateTime.Today),
                German = formGerman.Trim(),
                English = formEnglish.Trim()
            };
            await VocService.AddAsync(vocab);
        }

        formGerman = string.Empty;
        formEnglish = string.Empty;
        await LoadItems();
    }

    private void StartEdit(Vocabulary item)
    {
        editingItem = item;
        formGerman = item.German;
        formEnglish = item.English;
    }

    private void CancelEdit()
    {
        editingItem = null;
        formGerman = string.Empty;
        formEnglish = string.Empty;
    }

    private async Task Delete(Vocabulary item)
    {
        await VocService.DeleteAsync(item.Id);
        if (editingItem?.Id == item.Id)
            CancelEdit();
        await LoadItems();
    }
}
